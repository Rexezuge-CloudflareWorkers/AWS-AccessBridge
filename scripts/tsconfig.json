{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // ESNext rather than the repo default ES2022: the lint rules here expect
    // `Array#toSorted` and the iterator helpers, and against an older lib those
    // resolve to `any` rather than failing cleanly, which silently turns
    // type-aware rules into noise.
    "lib": ["ESNext", "DOM"],
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  // `functions/` is a Cloudflare Pages entrypoint, so it needs the generated
  // Workers types (`PagesFunction`, `Fetcher`) rather than Node's. It was
  // previously outside every tsconfig, so it was neither typechecked nor held to
  // the lint rules — and re-declared the forwarded-header constants it needed
  // because it could not import them.
  "include": ["**/*.ts"],
  "exclude": ["../functions/**/*"]
}