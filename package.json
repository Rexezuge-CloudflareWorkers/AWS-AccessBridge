{
  "name": "@aws-access-bridge/monorepo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/build/ensure-spa-shell-stub.ts && pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run test:integration",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "validate:locales": "node scripts/i18n/validate_locales.ts",
    "validate:migrations": "tsx scripts/migrations/verify-migrations.ts",
    "migrations:lock": "tsx scripts/migrations/verify-migrations.ts --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "test:coverage:integration": "vitest run --coverage --config test/integration/vitest.config.mts",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint --fix --quiet .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.10",
    "wrangler": "4.140.0"
  },
  "packageManager": "pnpm@11.2.2"
}
