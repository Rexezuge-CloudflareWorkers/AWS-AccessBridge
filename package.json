{
  "name": "@aws-access-bridge/monorepo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/build/ensure-spa-shell-stub.ts && pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run checks:fast && pnpm run test:coverage && pnpm run test:integration",
    "checks:fast": "pnpm run typecheck && pnpm run lint && pnpm run check:god-files && pnpm run validate:migrations && pnpm run validate:locales && pnpm run verify:spa-shell",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:scripts && pnpm run typecheck:functions",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "validate:locales": "tsx scripts/i18n/validate_locales.ts",
    "verify:spa-shell": "tsx scripts/build/verify-spa-shell.ts",
    "check:god-files": "node scripts/check-god-files.mjs",
    "validate:migrations": "tsx scripts/migrations/verify-migrations.ts",
    "migrations:lock": "tsx scripts/migrations/verify-migrations.ts --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "test:floci": "vitest run --config test/floci/vitest.config.mts",
    "test:coverage:integration": "vitest run --coverage --config test/integration/vitest.config.mts",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint --fix --quiet .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "jsdom": "^30.1.1",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@11.2.2"
}
