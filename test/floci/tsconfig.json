{
  // Editor/CI type surface for the Floci smoke tier. Extends the root config
  // rather than `test/tsconfig.json`, which omits the node types these helpers
  // need (`process.env`, `setTimeout`) and has no `provider-clients` mapping —
  // the app itself may not import that package, but this tier does, because the
  // endpoint override is injected through the factory it exports.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": {
      "@aws-access-bridge/background": ["../../apps/background/src"],
      "@aws-access-bridge/background/*": ["../../apps/background/src/*"],
      "@aws-access-bridge/backend-data": ["../../packages/backend-data/src"],
      "@aws-access-bridge/backend-data/*": ["../../packages/backend-data/src/*"],
      "@aws-access-bridge/backend-errors": ["../../packages/backend-errors/src"],
      "@aws-access-bridge/backend-errors/*": ["../../packages/backend-errors/src/*"],
      "@aws-access-bridge/backend-runtime": ["../../packages/backend-runtime/src"],
      "@aws-access-bridge/backend-runtime/*": ["../../packages/backend-runtime/src/*"],
      "@aws-access-bridge/backend-services": ["../../packages/backend-services/src"],
      "@aws-access-bridge/backend-services/*": ["../../packages/backend-services/src/*"],
      "@aws-access-bridge/provider-clients": ["../../packages/provider-clients/src"],
      "@aws-access-bridge/provider-clients/*": ["../../packages/provider-clients/src/*"],
      "@aws-access-bridge/shared": ["../../packages/shared/src"],
      "@aws-access-bridge/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "../../worker-configuration.d.ts", "../../packages/backend-runtime/src/env.d.ts"]
}
