{
  "name": "@aws-access-bridge/backend-data",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./crypto": "./src/crypto/index.ts",
    "./crypto/*": "./src/crypto/*.ts",
    "./dao": "./src/dao/index.ts",
    "./dao/*": "./src/dao/*.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-access-bridge/shared": "workspace:*",
    "@rexezuge/d1": "1.9.1",
    "@rexezuge/errors": "1.8.0",
    "@rexezuge/shared": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
