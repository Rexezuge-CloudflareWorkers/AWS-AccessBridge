{
  "name": "@aws-access-bridge/backend-services",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./access": "./src/access/index.ts",
    "./access/*": "./src/access/*.ts",
    "./account": "./src/account/index.ts",
    "./account/*": "./src/account/*.ts",
    "./audit": "./src/audit/index.ts",
    "./audit/*": "./src/audit/*.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./aws": "./src/aws/index.ts",
    "./aws/*": "./src/aws/*.ts",
    "./composition": "./src/composition/index.ts",
    "./composition/*": "./src/composition/*.ts",
    "./cost": "./src/cost/index.ts",
    "./cost/*": "./src/cost/*.ts",
    "./credential": "./src/credential/index.ts",
    "./credential/*": "./src/credential/*.ts",
    "./error": "./src/error/index.ts",
    "./error/*": "./src/error/*.ts",
    "./http": "./src/http/index.ts",
    "./http/*": "./src/http/*.ts",
    "./identity": "./src/identity/index.ts",
    "./identity/*": "./src/identity/*.ts",
    "./maintenance": "./src/maintenance/index.ts",
    "./maintenance/*": "./src/maintenance/*.ts",
    "./resource": "./src/resource/index.ts",
    "./resource/*": "./src/resource/*.ts",
    "./team": "./src/team/index.ts",
    "./team/*": "./src/team/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-access-bridge/backend-data": "workspace:*",
    "@aws-access-bridge/backend-errors": "workspace:*",
    "@aws-access-bridge/backend-runtime": "workspace:*",
    "@aws-access-bridge/provider-clients": "workspace:*",
    "@aws-access-bridge/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.9",
    "jose": "^6.2.11"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  }
}
