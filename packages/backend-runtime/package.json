{
  "name": "@aws-access-bridge/backend-runtime",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*.ts",
    "./constants": "./src/constants/index.ts",
    "./constants/*": "./src/constants/*.ts",
    "./constants/*/*": "./src/constants/*/*.ts",
    "./constants/*/index": "./src/constants/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rexezuge/runtime": "1.8.0",
    "@rexezuge/shared": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
