{
  // "$version": 1777605456,
  // "$minimumVersion": 1777605456,
  // Custom keys, left commented on purpose. Wrangler validates this file against
  // its own schema, flags both as unexpected top-level fields, and then suggests
  // upgrading because wrangler "might support this configuration option" — noise
  // for a key that is deliberately not wrangler's.
  //
  // Do not uncomment them. A version guard once read these two numbers with
  // `grep`, which matches commented text; the port to `jsonc-parser`, which
  // discards comments, turned that same comment from inert into fatal, because a
  // config copied straight from this template arrived with no `$version` at all and
  // the deploy refused to continue. Staleness is enforced structurally instead, by
  // `scripts/lib/wrangler-config/template-coverage.ts`: every binding and var below
  // must be present in the materialized `wrangler.jsonc`. That catches what a
  // hand-maintained integer could not — an omitted `INTERNAL_REQUEST_HMAC_SECRET`
  // breaks every internal self-call, and an omitted `ENVIRONMENT: "production"`
  // leaves the `DEV_AUTH_EMAIL` bypass armed in production.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aws-access-bridge",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": [],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  "assets": {
    "directory": "./apps/web/dist/",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRON_TASKS",
        "class_name": "CronTasksWorker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1777211205",
      "new_sqlite_classes": ["CronTasksWorker"],
    },
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "aws-access-bridge",
    },
  ],
  "d1_databases": [
    {
      "binding": "AccessBridgeDB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "aws-access-bridge-db",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "AccessBridgeKV",
      "id": "00000000000000000000000000000000",
      // "kv_name": "aws-access-bridge-kv",
    },
  ],
  "secrets_store_secrets": [
    {
      // Long-term IAM access keys in the `credentials` D1 table.
      "binding": "CREDENTIAL_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "aws-access-bridge-credential-encryption-key",
    },
    {
      // Temporary STS credentials in the `credentials_cache` KV namespace.
      "binding": "CREDENTIAL_CACHE_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "aws-access-bridge-credential-cache-encryption-key",
    },
    {
      // Legacy single key for both surfaces; a read-only fallback so rows written
      // before the split stay readable. Seed this with the value the two bindings
      // above held before the split, then remove it once every row has been
      // rewritten. See packages/backend-services/src/composition/encryptionKeys.ts
      "binding": "AES_ENCRYPTION_KEY_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "aws-access-bridge-aes-encryption-key",
    },
    {
      "binding": "INTERNAL_REQUEST_HMAC_SECRET",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "aws-access-bridge-internal-request-hmac-secret",
    },
  ],
  "vars": {
    "POLICY_AUD": "you-cloudflare-zero-trust-application-aud",
    "TEAM_DOMAIN": "https://your-cloudflare-zero-trust-team-domain.cloudflareaccess.com",
    "MAX_TOKENS_PER_USER": "5",
    "MAX_TOKEN_EXPIRY_DAYS": "90",
    "PRINCIPAL_TRUST_CHAIN_LIMIT": "3",
    "AUDIT_LOG_RETENTION_DAYS": "90",
    "DEMO_MODE": "false",
    // Comma-separated AWS regions the resource inventory sweeps. Empty means the
    // built-in commercial-region list in
    // `backend-runtime/src/constants/InventoryRegions.ts` — which is also the
    // fallback, so blanking this cannot silently sweep nothing. Set it to trim the
    // list and cut collection API calls per account. S3 is global and ignores it.
    "INVENTORY_REGIONS": "",
    // Only the literal "production" arms the DEV_AUTH_EMAIL guard. Set this on
    // every real deployment.
    "ENVIRONMENT": "production",
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
}
